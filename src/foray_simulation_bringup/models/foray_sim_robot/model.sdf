<?xml version="1.0" ?>
<!-- 仿真机器人：单车体 + 前向 Mid-360（32 线）+ IMU。
     参数口径沿用 SMBU pb2025_robot_description 的 front_mid360 块（见 THIRD_PARTY_NOTICES）：
     32 线 / -7°~+52° / 1875 水平采样 / 20 Hz / 0.1~40 m / 1 cm 噪声。
     雷达高度 0.27962 m 来自 RMUL 2027 场地规格（迁移包 parameters.json，
     水平雷达需高于 200 mm 高地、低于 270 mm 隧道顶）。 -->
<sdf version="1.8">
    <model name="foray_sim_robot">
        <static>false</static>
        <self_collide>false</self_collide>

        <link name="base_footprint"/>

        <link name="chassis">
            <pose>0 0 0.075 0 0 0</pose>
            <inertial>
                <mass>12.0</mass>
                <inertia>
                    <ixx>0.08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.12</iyy>
                    <iyz>0</iyz>
                    <izz>0.16</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.30 0.24 0.15</size>
                    </box>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <box>
                        <size>0.30 0.24 0.15</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.2 0.3 0.6 1</ambient>
                    <diffuse>0.2 0.3 0.6 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>
        </link>

        <joint name="chassis_joint" type="fixed">
            <parent>base_footprint</parent>
            <child>chassis</child>
        </joint>

        <link name="front_mid360">
            <pose>0.08 0 0.27962 0 0 0</pose>
            <inertial>
                <mass>0.2</mass>
                <inertia>
                    <ixx>1e-4</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1e-4</iyy>
                    <iyz>0</iyz>
                    <izz>1e-4</izz>
                </inertia>
            </inertial>
            <sensor name="front_mid360_lidar" type="gpu_lidar">
                <!-- 不用 gz 默认的 <model>/<link>/<sensor> 全名：下游按 TF 帧名取变换，
                     帧名必须与 robot_state_publisher / 静态 TF 一致 -->
                <ignition_frame_id>front_mid360</ignition_frame_id>
                <always_on>1</always_on>
                <visualize>false</visualize>
                <!-- MID-360 实际出点率 10 Hz（Livox 手册默认值），软件渲染也能跟上 -->
                <update_rate>10</update_rate>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>1875</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159265</min_angle>
                            <max_angle>3.14159265</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>32</samples>
                            <min_angle>-0.12217304764</min_angle>
                            <max_angle>0.90757121104</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>40.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
            <sensor name="front_mid360_imu" type="imu">
                <ignition_frame_id>front_mid360</ignition_frame_id>
                <always_on>1</always_on>
                <update_rate>200</update_rate>
                <imu>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                            </noise>
                        </z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </link>

        <joint name="front_mid360_joint" type="fixed">
            <parent>chassis</parent>
            <child>front_mid360</child>
        </joint>

        <!-- 平面速度控制：Nav2 直接给 /cmd_vel，无需轮系关节（仿真里不追求接触精度） -->
        <plugin filename="ignition-gazebo-velocity-control-system"
                name="ignition::gazebo::systems::VelocityControl">
            <initial_linear>0 0 0</initial_linear>
            <initial_angular>0 0 0</initial_angular>
        </plugin>
    </model>
</sdf>
