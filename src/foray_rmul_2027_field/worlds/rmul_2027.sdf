<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="rmul_2027">
    <physics name="physics" type="ignored">
      <max_step_size>.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <!-- IMU 传感器由 imu-system 驱动；缺了它 gpu_lidar 正常但 imu 话题根本不会出现 -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>.75 .75 .75 1</ambient>
      <background>.16 .17 .19 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="arena_light" type="directional">
      <pose>6 4 10 0 0 0</pose>
      <direction>-.3 .2 -1</direction>
      <diffuse>.45 .45 .45 1</diffuse>
      <specular>.1 .1 .1 1</specular>
    </light>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>.75 .75 .75</ambient_light>
        <background_color>.16 .17 .19</background_color>
        <camera_pose>15 -9 12 0 .62 2.18</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager" />
      <plugin filename="InteractiveViewControl" name="Interactive view control" />
      <plugin filename="SelectEntities" name="Select Entities" />
    </gui>
    <include>
      <uri>model://rmul_2027</uri>
      <name>rmul_2027</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
